#!/usr/bin/env bash
# Change the external display position, persist it, and apply it immediately.
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
I3_DIR="$CONFIG_HOME/i3"
DISPLAY_POSITION_DIR="$I3_DIR/display-position"
CONFIG_FILE="$DISPLAY_POSITION_DIR/dual-display.conf"
WATCHER="$DISPLAY_POSITION_DIR/dual-display.sh"
WALLPAPER="$I3_DIR/backgrounds/little.png"
VALID_POSITIONS="right above left below"

usage() {
    cat <<'USAGE'
Usage:
  i3-display-position                 Open the position menu
  i3-display-position above|right|left|below
  i3-display-position cycle           Cycle right -> above -> left -> below
  i3-display-position status          Show the current position and XRandR layout
  i3-display-position apply           Re-apply the saved position

The result is saved in:
  ~/.config/i3/display-position/dual-display.conf
USAGE
}

load_config() {
    INTERNAL_OUTPUT="eDP-1"
    EXTERNAL_OUTPUT="HDMI-1"
    EXTERNAL_POSITION="right"

    if [ -r "$CONFIG_FILE" ]; then
        # shellcheck disable=SC1090
        . "$CONFIG_FILE"
    fi

    case "$EXTERNAL_POSITION" in
        right) POSITION_ARG="--right-of" ;;
        left) POSITION_ARG="--left-of" ;;
        above) POSITION_ARG="--above" ;;
        below) POSITION_ARG="--below" ;;
        *)
            printf "Invalid EXTERNAL_POSITION: %s\n" "$EXTERNAL_POSITION" >&2
            exit 2
            ;;
    esac
}

save_position() {
    local position="$1"
    local tmp_file

    case "$position" in
        right|left|above|below) ;;
        *)
            printf "Invalid position: %s\n" "$position" >&2
            exit 2
            ;;
    esac

    mkdir -p "$(dirname "$CONFIG_FILE")"
    if [ ! -f "$CONFIG_FILE" ]; then
        cat > "$CONFIG_FILE" <<'DEFAULT_CONFIG'
# i3 dual-display defaults used by display-position/dual-display.sh.
# Supported EXTERNAL_POSITION values: right, left, above, below.
INTERNAL_OUTPUT="eDP-1"
EXTERNAL_OUTPUT="HDMI-1"
EXTERNAL_POSITION="right"
DEFAULT_CONFIG
    fi

    tmp_file=$(mktemp "${CONFIG_FILE}.XXXXXX")
    awk -v position="$position" '
        BEGIN { replaced = 0 }
        /^EXTERNAL_POSITION=/ {
            print "EXTERNAL_POSITION=\"" position "\""
            replaced = 1
            next
        }
        { print }
        END {
            if (!replaced) {
                print "EXTERNAL_POSITION=\"" position "\""
            }
        }
    ' "$CONFIG_FILE" > "$tmp_file"
    mv "$tmp_file" "$CONFIG_FILE"
    chmod 644 "$CONFIG_FILE"
}

apply_layout() {
    local external_state

    load_config

    if ! xrandr --query >/dev/null 2>&1; then
        printf "X display is unavailable; saved position: %s\n" "$EXTERNAL_POSITION" >&2
        return 0
    fi

    external_state=$(xrandr --query | awk -v output="$EXTERNAL_OUTPUT" '$1 == output { print $2; exit }')
    if [ "$external_state" = "connected" ]; then
        xrandr --output "$EXTERNAL_OUTPUT" --auto "$POSITION_ARG" "$INTERNAL_OUTPUT"
        feh --bg-fill "$WALLPAPER" >/dev/null 2>&1 || true
        printf "Applied: %s is %s of %s\n" "$EXTERNAL_OUTPUT" "$EXTERNAL_POSITION" "$INTERNAL_OUTPUT"
    else
        printf "Saved: %s is %s of %s (external display not connected)\n" \
            "$EXTERNAL_OUTPUT" "$EXTERNAL_POSITION" "$INTERNAL_OUTPUT"
    fi
}

restart_watcher() {
    pkill -f '^bash .*dual-display.sh$' 2>/dev/null || true

    if command -v i3-msg >/dev/null 2>&1 && i3-msg -t get_version >/dev/null 2>&1; then
        i3-msg "exec --no-startup-id $WATCHER" >/dev/null
    else
        nohup "$WATCHER" >/dev/null 2>&1 &
    fi
}

choose_position() {
    local choice

    if [ -n "${DISPLAY:-}" ] && command -v dmenu >/dev/null 2>&1; then
        choice=$(printf '%s\n' right above left below | dmenu -i -p 'HDMI position:')
    else
        printf 'Choose HDMI position: right above left below\n> ' >&2
        read -r choice
    fi

    if [ -z "$choice" ]; then
        exit 0
    fi
    printf '%s\n' "$choice"
}

current_position() {
    load_config
    printf '%s\n' "$EXTERNAL_POSITION"
}

cycle_position() {
    local current next
    current=$(current_position)
    next=$(printf '%s\n' $VALID_POSITIONS | awk -v current="$current" '
        { positions[NR] = $0 }
        $0 == current { found = NR }
        END {
            if (found) print positions[(found % NR) + 1]
            else print positions[1]
        }
    ')
    printf '%s\n' "$next"
}

case "${1:-}" in
    "" )
        position=$(choose_position)
        save_position "$position"
        apply_layout
        restart_watcher
        ;;
    -h|--help|help)
        usage
        ;;
    status)
        load_config
        printf 'Configured position: %s\n' "$EXTERNAL_POSITION"
        printf 'Config file: %s\n\n' "$CONFIG_FILE"
        xrandr --listmonitors 2>/dev/null || true
        ;;
    apply)
        apply_layout
        restart_watcher
        ;;
    cycle)
        position=$(cycle_position)
        save_position "$position"
        apply_layout
        restart_watcher
        ;;
    right|left|above|below)
        save_position "$1"
        apply_layout
        restart_watcher
        ;;
    *)
        printf 'Unknown argument: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
